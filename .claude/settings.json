{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(python3 scripts/:*)",
      "Bash(python scripts/:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Write(scripts/git-hooks/**)",
      "Edit(scripts/git-hooks/**)",
      "Write(.ai/**)",
      "Edit(.ai/**)",
      "Bash(mkdir -p .claude/*)",
      "Bash(mkdir -p scripts/*)",
      "Bash(chmod +x scripts/git-hooks/*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(brew install:*)",
      "Bash(docker compose:*)",
      "Bash(terraform plan:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(ssh-keygen:*)",
      "Bash(chmod 777:*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bump_session_counter.py\" prompt_count"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bump_session_counter.py\" message_count"
          }
        ]
      }
    ]
  }
}
