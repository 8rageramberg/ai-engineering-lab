#!/usr/bin/env python3
"""post-commit hook: log one coding_session_logged row per commit, with zero typed input.

One-time setup (see AGENTS.md): `git config core.hooksPath scripts/git-hooks`

Dual-writes the same row to two places: appends to docs/worklog/ai_sessions.jsonl (the
durable, human-auditable system of record) AND inserts it into the live `events` table (so
the dashboard reflects the commit immediately, with no manual reseed). The jsonl write is
the one that must succeed for the row to exist at all -- the live-table insert is pure
enrichment for queryability and degrades to a stderr warning on any failure.

Must never block or fail a commit. Every risky step (git plumbing, transcript reads, the
live-table insert) is wrapped so a failure degrades to null/0 fields plus a stderr warning,
never a non-zero exit.
"""

import json
import os
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

# feature_area heuristic: map changed-file path prefixes to the controlled vocabulary in
# .ai/TELEMETRY_RULES.md (frontend | backend | infra | ai | observability | docs | todo_agent
# | mobile). Checked in order, first match wins; the area touching the most changed files is
# used. Extend this list as frontend/, backend/, mobile/ etc. directories come into existence.
PATH_PREFIX_TO_FEATURE_AREA = [
    ("frontend/", "frontend"),
    ("backend/app/ai/", "ai"),
    ("backend/app/telemetry/", "observability"),
    ("backend/", "backend"),
    ("mobile/", "mobile"),
    ("docs/", "docs"),
    ("scripts/", "infra"),
    (".ai/", "infra"),
    (".claude/", "infra"),
    ("infra/", "infra"),
    ("terraform/", "infra"),
]
DEFAULT_FEATURE_AREA = "infra"

# Per-category token pricing (USD per million tokens, Claude Sonnet list pricing as of
# 2026-06-07 -- these may drift over time and should be checked periodically against the
# official usage panel / pricing page). Cache reads are ~10x cheaper than fresh input and
# cache writes carry a premium over fresh input -- pricing each category separately is what
# keeps estimated_cost_usd believable; blending them into one rate overstates cost ~5x.
# Enrichment only -- never a billing record. See the 2026-06-07 DECISIONS.md entry on not
# relying on Claude's internal logs as a system of record.
INPUT_USD_PER_MTOK = 3.0
OUTPUT_USD_PER_MTOK = 15.0
CACHE_WRITE_USD_PER_MTOK = 3.75
CACHE_READ_USD_PER_MTOK = 0.30


def warn(message):
    print(f"post-commit: {message}", file=sys.stderr)


def git(repo_root, *args):
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, cwd=repo_root, check=True
    ).stdout


def derive_commit_facts(repo_root):
    sha = git(repo_root, "rev-parse", "HEAD").strip()
    branch = git(repo_root, "rev-parse", "--abbrev-ref", "HEAD").strip()
    changed_files = [
        line
        for line in git(repo_root, "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", sha).splitlines()
        if line
    ]
    commit_timestamp = git(repo_root, "show", "-s", "--format=%cI", sha).strip()
    message = git(repo_root, "log", "-1", "--format=%B", sha).rstrip("\n")
    return sha, branch, changed_files, commit_timestamp, message


def derive_feature_area(changed_files):
    counts = {}
    for path in changed_files:
        for prefix, area in PATH_PREFIX_TO_FEATURE_AREA:
            if path.startswith(prefix):
                counts[area] = counts.get(area, 0) + 1
                break
    if not counts:
        return DEFAULT_FEATURE_AREA
    return max(counts.items(), key=lambda kv: kv[1])[0]


def read_counter(counter_path):
    try:
        data = json.loads(counter_path.read_text(encoding="utf-8"))
        return data.get("prompt_count", 0), data.get("message_count", 0), data.get("window_started_at")
    except Exception as exc:
        warn(f"could not read session counter, defaulting to zero ({exc})")
        return 0, 0, None


def reset_counter(counter_path):
    try:
        counter_path.write_text(
            json.dumps(
                {
                    "prompt_count": 0,
                    "message_count": 0,
                    "window_started_at": datetime.now(timezone.utc).isoformat(),
                }
            ),
            encoding="utf-8",
        )
    except Exception as exc:
        warn(f"could not reset session counter ({exc})")


def parse_iso(timestamp):
    return datetime.fromisoformat(timestamp.replace("Z", "+00:00"))


def find_transcript_dir(repo_root):
    """Match this repo's Claude Code transcript dir under ~/.claude/projects/.

    The directory name encodes the repo's absolute path with `/` replaced by `-`.
    """
    base = Path.home() / ".claude" / "projects"
    if not base.is_dir():
        return None
    candidate = base / str(repo_root.resolve()).replace("/", "-")
    if candidate.is_dir():
        return candidate
    suffix = f"-{repo_root.name}"
    for entry in base.iterdir():
        if entry.is_dir() and entry.name.endswith(suffix):
            return entry
    return None


def enrich_from_transcripts(repo_root, window_started_at):
    """Best-effort token/model enrichment from the local Claude Code transcript directory.

    Returns (input_tokens, output_tokens, total_tokens, cache_read_tokens,
    estimated_cost_usd, model_name, actual_window_started_at). Each usage category (fresh
    input, output, cache write, cache read) is summed and priced independently -- see the
    per-category rate constants above for why blending them would misprice the result.

    Also derives the true session start time from the earliest transcript timestamp, so if
    commits are sparse and days pass without work, the window doesn't artificially bloat.
    This makes the telemetry self-healing: window_started_at is grounded in reality (actual
    session messages), not in stale counter state.

    Wrapped end-to-end: any failure (missing dir, unfamiliar schema, bad timestamps) degrades
    to nulls rather than blocking the commit. Treated purely as enrichment, never a dependency.
    """
    nulls = (None, None, None, None, None, None, None)
    if not window_started_at:
        return nulls
    try:
        window_start = parse_iso(window_started_at)
    except ValueError:
        return nulls

    transcript_dir = find_transcript_dir(repo_root)
    if transcript_dir is None:
        return nulls

    window_end = datetime.now(timezone.utc)
    seen_message_ids = set()
    actual_window_started = None  # Track the earliest timestamp we actually see in transcripts
    # Track each usage category independently -- cache reads are ~10x cheaper than fresh
    # input and cache writes carry a premium, so merging them into one bucket (the original
    # bug) both inflates the token count and misprices the result by roughly 5x.
    input_tokens = 0
    output_tokens = 0
    cache_creation_tokens = 0
    cache_read_tokens = 0
    model_counts = {}

    for jsonl_path in transcript_dir.glob("*.jsonl"):
        try:
            with jsonl_path.open(encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                    except json.JSONDecodeError:
                        continue

                    timestamp = entry.get("timestamp")
                    if not timestamp:
                        continue
                    try:
                        entry_time = parse_iso(timestamp)
                    except ValueError:
                        continue
                    if not (window_start <= entry_time <= window_end):
                        continue

                    # Track the earliest timestamp we see in the transcripts -- the true
                    # session start, independent of the (potentially stale) counter value.
                    if actual_window_started is None or entry_time < actual_window_started:
                        actual_window_started = entry_time

                    message = entry.get("message")
                    if not isinstance(message, dict):
                        continue
                    usage = message.get("usage")
                    if not isinstance(usage, dict):
                        continue

                    # The same assistant message is logged multiple times (streaming deltas);
                    # dedupe on the API message id so usage is only counted once.
                    message_id = message.get("id")
                    if message_id:
                        if message_id in seen_message_ids:
                            continue
                        seen_message_ids.add(message_id)

                    input_tokens += usage.get("input_tokens", 0)
                    output_tokens += usage.get("output_tokens", 0)
                    cache_creation_tokens += usage.get("cache_creation_input_tokens", 0)
                    cache_read_tokens += usage.get("cache_read_input_tokens", 0)

                    model_name = message.get("model")
                    if model_name:
                        model_counts[model_name] = model_counts.get(model_name, 0) + 1
        except Exception as exc:
            warn(f"skipping unreadable transcript {jsonl_path.name} ({exc})")
            continue

    if not seen_message_ids:
        return nulls

    # total_tokens is a "work effort" proxy: fresh input + output + cache writes (all of
    # which represent real model work). Cache reads are reported separately
    # (cache_read_tokens) so near-free re-reads of cached context don't dwarf the figure.
    total_tokens = input_tokens + output_tokens + cache_creation_tokens
    estimated_cost_usd = round(
        (
            input_tokens * INPUT_USD_PER_MTOK
            + output_tokens * OUTPUT_USD_PER_MTOK
            + cache_creation_tokens * CACHE_WRITE_USD_PER_MTOK
            + cache_read_tokens * CACHE_READ_USD_PER_MTOK
        )
        / 1_000_000,
        6,
    )
    model_name = max(model_counts.items(), key=lambda kv: kv[1])[0] if model_counts else None
    # Return the actual window start from transcripts, not the (potentially stale) counter value.
    actual_window_started_iso = (
        actual_window_started.isoformat() if actual_window_started else None
    )
    return input_tokens, output_tokens, total_tokens, cache_read_tokens, estimated_cost_usd, model_name, actual_window_started_iso


def append_event(worklog_path, record):
    worklog_path.parent.mkdir(parents=True, exist_ok=True)
    with worklog_path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")


# Columns that exist directly on the `events` table per .ai/TELEMETRY_RULES.md. Anything else
# the worklog record carries (prompt_count, summary, changed_files, window_started_at, ...)
# folds into `metadata` JSONB -- mirrors backend/seed.py's to_row() so a dual-written row is
# byte-for-byte the same shape as one produced by re-running the seed script from the jsonl.
CORE_EVENT_FIELDS = {
    "id", "created_at", "event_type", "source", "feature_area", "task_id", "commit_sha",
    "model_provider", "model_name", "input_tokens", "output_tokens", "total_tokens",
    "estimated_cost_usd", "latency_ms", "success",
}

INSERT_EVENT_SQL = r"""
\getenv event_row_json EVENT_ROW_JSON
INSERT INTO events (
    id, created_at, event_type, source, feature_area, task_id, commit_sha,
    model_provider, model_name, input_tokens, output_tokens, total_tokens,
    estimated_cost_usd, latency_ms, success, metadata
)
SELECT
    (r->>'id')::uuid,
    (r->>'created_at')::timestamptz,
    r->>'event_type',
    r->>'source',
    r->>'feature_area',
    NULLIF(r->>'task_id', '')::uuid,
    r->>'commit_sha',
    r->>'model_provider',
    r->>'model_name',
    COALESCE((r->>'input_tokens')::int, 0),
    COALESCE((r->>'output_tokens')::int, 0),
    COALESCE((r->>'total_tokens')::int, 0),
    COALESCE((r->>'estimated_cost_usd')::numeric, 0),
    NULLIF(r->>'latency_ms', '')::int,
    COALESCE((r->>'success')::boolean, true),
    COALESCE(r->'metadata', '{}'::jsonb)
FROM (SELECT :'event_row_json'::jsonb AS r) t
ON CONFLICT (id) DO NOTHING;
"""


def to_event_row(record):
    extra = {k: v for k, v in record.items() if k not in CORE_EVENT_FIELDS}
    metadata = {**extra.pop("metadata", {}), **extra}
    row = {field: record.get(field) for field in CORE_EVENT_FIELDS}
    if row.get("success") is None:
        row["success"] = True
    row["metadata"] = metadata
    return row


def insert_event_row(repo_root, record):
    """Best-effort dual-write of the same row straight into the live `events` table.

    Routed through `docker compose exec` into the postgres container rather than connecting
    from the host directly: this machine also runs a native Postgres bound to 127.0.0.1:5432,
    which silently shadows the compose service's published port, and going through the
    container's own network namespace needs no extra Postgres driver on the host either.
    The jsonl write above is the durable system of record regardless of whether this succeeds
    -- any failure here (compose not running, daemon unreachable, etc.) is purely a stderr
    warning, never a reason to fail or block the commit.
    """
    payload = json.dumps(to_event_row(record))
    try:
        result = subprocess.run(
            [
                "docker", "compose", "exec", "-T", "-e", f"EVENT_ROW_JSON={payload}",
                "postgres", "psql", "-U", "portfolio", "-d", "portfolio", "-v", "ON_ERROR_STOP=1",
            ],
            input=INSERT_EVENT_SQL,
            capture_output=True,
            text=True,
            cwd=repo_root,
            timeout=15,
        )
    except Exception as exc:
        warn(f"could not reach the live events table, dashboard won't see this commit yet ({exc})")
        return
    if result.returncode != 0:
        detail = result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "unknown error"
        warn(f"live events table insert failed, dashboard won't see this commit yet ({detail})")


def main():
    try:
        repo_root = Path(
            subprocess.run(
                ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
            ).stdout.strip()
        )
    except Exception as exc:
        warn(f"could not resolve repo root, skipping telemetry row ({exc})")
        return

    counter_path = repo_root / ".ai" / "session_counter.json"
    worklog_path = repo_root / "docs" / "worklog" / "ai_sessions.jsonl"

    try:
        sha, branch, changed_files, commit_timestamp, message = derive_commit_facts(repo_root)
    except Exception as exc:
        warn(f"could not derive commit facts, skipping telemetry row ({exc})")
        return

    prompt_count, message_count, window_started_at = read_counter(counter_path)
    feature_area = derive_feature_area(changed_files)
    input_tokens, output_tokens, total_tokens, cache_read_tokens, estimated_cost_usd, model_name, actual_window_started_at = enrich_from_transcripts(
        repo_root, window_started_at
    )

    # Use the actual session start from transcripts if available, falling back to the
    # counter's value if no transcripts were found.
    final_window_started_at = actual_window_started_at if actual_window_started_at else window_started_at

    record = {
        "id": str(uuid.uuid4()),
        "created_at": datetime.now(timezone.utc).isoformat(),
        "event_type": "coding_session_logged",
        "source": "git_hook",
        "model_provider": "anthropic",
        "model_name": model_name,
        "session_type": None,
        "feature_area": feature_area,
        "task_id": None,
        "commit_sha": sha,
        "prompt_count": prompt_count,
        "message_count": message_count,
        "window_started_at": final_window_started_at,
        "input_tokens": input_tokens,
        "output_tokens": output_tokens,
        "total_tokens": total_tokens,
        "cache_read_tokens": cache_read_tokens,
        "estimated_cost_usd": estimated_cost_usd,
        "summary": message,
        "changed_files": changed_files,
        "metadata": {"branch": branch, "commit_timestamp": commit_timestamp},
    }

    try:
        append_event(worklog_path, record)
    except Exception as exc:
        warn(f"could not append worklog row, nothing logged ({exc})")
        return

    reset_counter(counter_path)

    # Dual-write: the jsonl above is the durable, human-auditable system of record; this is
    # purely so the live dashboard reflects the commit immediately without a manual reseed.
    insert_event_row(repo_root, record)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        warn(f"unexpected failure, commit not affected ({exc})")
    sys.exit(0)
