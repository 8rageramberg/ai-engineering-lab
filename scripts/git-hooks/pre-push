#!/bin/bash
# Pre-push hook: validate the codebase before pushing to remote.
# This runs on every `git push` and blocks the push if tests or builds fail.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-push validation...${NC}"

# Run backend tests
echo -e "${YELLOW}Running backend tests...${NC}"
cd "$REPO_ROOT/backend"
PYTHON=$(
  for candidate in \
    "$CONDA_PYTHON" \
    "$HOME/opt/miniconda3/bin/python3" \
    "$HOME/miniconda3/bin/python3" \
    "$HOME/anaconda3/bin/python3" \
    "$(command -v python3)"; do
    [ -x "$candidate" ] && "$candidate" -c "import pytest" 2>/dev/null && echo "$candidate" && break
  done
)
if [ -z "$PYTHON" ]; then
    echo -e "${RED}❌ Could not find a Python with pytest installed. Push blocked.${NC}"
    exit 1
fi
if ! "$PYTHON" -m pytest tests/ -v; then
    echo -e "${RED}❌ Backend tests failed. Push blocked.${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Backend tests passed${NC}"

# Run frontend build check
echo -e "${YELLOW}Running frontend build check...${NC}"
cd "$REPO_ROOT/frontend"
if ! npm run build > /dev/null 2>&1; then
    echo -e "${RED}❌ Frontend build failed. Push blocked.${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Frontend build succeeded${NC}"

echo -e "${GREEN}✓ All pre-push checks passed. Push will proceed.${NC}"
exit 0
